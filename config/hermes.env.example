# =============================================================================
#  Hermes .env TEMPLATE — list of secret KEY NAMES you must provide.
#  Copy to $HERMES_HOME/.env and fill in YOUR OWN values.
#  NEVER commit real secrets to the repo.
# =============================================================================

# OpenRouter (routes models for both Hermes and the OpenClaw bridge)
OPENROUTER_API_KEY=your_openrouter_key_here

# Telegram bot for the Hermes gateway (message the bot to reach the stack)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Optional additional providers (uncomment as needed) ---------------------
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=...
# KIMI_API_KEY=...

# --- OpenClaw / bridge overrides (optional) ----------------------------------
# NODE_BIN=C:/Program Files/nodejs/node.exe
# OPENCLAW_MJS=$APPDATA/npm/node_modules/openclaw/openclaw.mjs
