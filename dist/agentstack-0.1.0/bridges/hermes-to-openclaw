#!/usr/bin/env bash
# =============================================================================
#  hermes-to-openclaw — Hermes -> OpenClaw handoff.
#
#  Hermes (the brain) delegates a one-shot task to OpenClaw (the hands / executor).
#  OpenClaw does the work, reads/writes the shared Obsidian vault, and returns
#  its result as JSON.
#
#  Usage:
#    hermes-to-openclaw "task"
#    echo "task" | hermes-to-openclaw
#
#  Windows-safe: invokes node directly against the package entry (bypasses the
#  npm .cmd shim that corrupts multi-line prompts and swallows --json).
# =============================================================================
set -euo pipefail

if [ "$#" -gt 0 ]; then prompt="$*"; else prompt="$(cat)"; fi
[ -n "${prompt//[[:space:]]/}" ] || { echo "Usage: hermes-to-openclaw \"task\"" >&2; exit 2; }

NODE_BIN="${NODE_BIN:-C:/Program Files/nodejs/node.exe}"
OPENCLAW_MJS="${OPENCLAW_MJS:-$APPDATA/npm/node_modules/openclaw/openclaw.mjs}"

if [ ! -f "$OPENCLAW_MJS" ]; then
  for c in "$APPDATA/npm/node_modules/openclaw/openclaw.mjs" \
           "$HOME/AppData/Roaming/npm/node_modules/openclaw/openclaw.mjs"; do
    if [ -f "$c" ]; then OPENCLAW_MJS="$c"; break; fi
  done
fi

if [ ! -f "$OPENCLAW_MJS" ]; then
  echo "Cannot find openclaw.mjs. Set OPENCLAW_MJS." >&2; exit 127
fi

"$NODE_BIN" "$OPENCLAW_MJS" infer model run --local \
  --model openrouter/auto \
  --prompt "$prompt" --json 2>/dev/null
