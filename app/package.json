{
  "name": "agentstack-app",
  "version": "0.1.0",
  "description": "AgentStack desktop — one clean system: Hermes brain + OpenClaw hands + Obsidian memory.",
  "main": "app/main.js",
  "author": "Cyralyx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/cli.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.cyralyx.agentstack",
    "productName": "AgentStack",
    "files": [
      "app/**/*",
      "council/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentStack"
    }
  }
}
