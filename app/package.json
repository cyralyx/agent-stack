{
  "name": "agentstack-app",
  "version": "0.2.0",
  "description": "AgentStack desktop — compatibility & orchestration layer: Hermes brain + OpenClaw hands + Obsidian memory in one polished GUI.",
  "main": "main.js",
  "author": "Cyralyx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . AgentStack --platform=win32 --arch=x64 --out=release --overwrite --icon=logo.ico --app-version=0.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.cyralyx.agentstack",
    "productName": "AgentStack",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "logo.png",
      "logo.ico"
    ],
    "extraResources": [
      { "from": "../council", "to": "council" },
      { "from": "../lib", "to": "lib" },
      { "from": "../modules", "to": "modules" },
      { "from": "../bin", "to": "bin" },
      { "from": "../bridges", "to": "bridges" },
      { "from": "../skills", "to": "skills" },
      { "from": "../config", "to": "config" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentStack"
    }
  }
}
